---
title: "Flown – well-drawn svg world flags with a small file size"
---

extends /_/layouts/default

block body
  article.intro.mb3
    p
      small
        | This library is a
        strong  work in progress,
        |  involving hundreds of hours of methodical work. 
        a(href="/todo") #{invalid.length} flags
        |  do not yet meet the criteria for inclusion. Watch this repository on 
        a(href=links.github) GitHub
        |  to know when the first release becomes available.

    include:md /_/intro.md

  .quicklook.mb1
    dl.gr2.g3
      dt.bt.pb2.nano Flags
      dd.bt.pb1= flags.length

      dt.bt.pb2.nano Colours
      dd.bt.pb1= palette.length

      dt.bt.pb2.nano Aspect Ratio
      dd.bt.pb1.ratio
        | 5
        span.mt :
        | 3

        svg(
          viewBox="0 0 120 72"
          fill="none"
          stroke="#fff"
        )
          path(d="M0 0h120v72H0z" fill="#fff3")
          path(d="M0 24h120M0 48h120M24 0v72M48 0v72M72 0v72m24-72v72z")

      - const source = flags.reduce((m, f) => m + f.size.source, 0)
      - const output = flags.reduce((m, f) => m + f.size.output, 0)
      dt.bt.pb2.nano Compression
      dd.bt.pb1
        = (100 * (1 - output / source)).toFixed(1)
        span.mt %

      dt.bt.pb2.nano Average Size
      dd.bt.pb1
        = (output / flags.length / 1024).toFixed(1)
        span.mt kB

  .colors.fx.pb3.g3.bt
    h2.mbe2.nano Colour Palette

    ul.gr1.fxg.g3
      each color in palette
        li
          +color(color)
  
  .tags.fx.pb3.g3.bt
    h2.mbe1.nano Tags

    nav.fx.fxw.g3
      each tag in tagList
        a(href=`/tags/${tag.slug}`)
          = tag.title

  .jumpto.fx.pb3.g3.bt
    h2.mbe1.nano Regions
    nav.fx.fxw.g3
      each region in regions
        a(href=`#${region.slug}`)
          = region.name

  .jumpto.fx.pb3.g3.bt
    h2.mbe1.nano Subregions
    nav.fx.fxw.g3
      each region in regions
        each subregion in region.list
          a(href=`#${subregion.slug}`)
            = subregion.name

  .flags
    each region in regions
      .pb3(id=region.slug)
        h2
          = region.name

        each subregion in region.list
          h3.mbs3.mbe2(id=subregion.slug)= subregion.name
          ul.gr2.g3
            each flag in subregion.list
              +flag-list-item(flag)

block append head
  style
    include:sass /assets/sass/_home.sass
