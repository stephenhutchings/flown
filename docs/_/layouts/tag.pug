extends /_/layouts/default

block body
  .pb3
    h1= title
    p.pb2
      if list.length === 1
        | Only one flag uses this colour.
      else
        | There are #{list.length} flags that match this tag.

  ul.gr2.g3
    each id in list
      - const flag = flags[id]
      if flag
        +flag-list-item(flag)
