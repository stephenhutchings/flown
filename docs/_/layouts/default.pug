include /_/mixins/color
include /_/mixins/flag
include /_/mixins/flag-list-item

- const cachebust = Date.now().toString(16).slice(-8)

html
  head
    block head
      meta(charset="utf-8")
      meta(
        name="viewport"
        content="width=device-width, initial-scale=1, viewport-fit=cover"
      )

      link(rel="stylesheet" href=`/assets/app.css?${cachebust}`)
      link(rel="shortcut icon" href="/assets/favicon.png")
      
      title= title

  body(class=`page-${meta.url.split("/")[1] || "home"}`)
    header
      nav.fx.g3.pb2.nano.aic
        a(href="/")
          svg(width="32" height="32")
            rect(width="32" height="32" rx="4" ry="4" fill="#faf6f5")
            path(d="M27 11V6Q18 9 8 6H5v20h3v-5q10 3 19 0v-5q-9 3-19 0v-5q10 3 19 0" fill="#121e25")

        a(href="/about/") about
        a(href="/size/") size
        a.miea(href="/todo/") todo

        //- a(href=links.href)= links.npm.label
        a(href=links.git.href)= links.git.label

    block body
      != content

    block scripts
      script(src=`/assets/app.js?${cachebust}`)